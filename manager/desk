#!/bin/sh
# The owner's desk: reports they asked for, read as pages on the floor. Each report is a real file
# in a folder for what it is; `desk where <folder>` puts the folders in a synced folder.
#   ./desk add "<title>" <report.md | -> [--from "<your name>"] [--folder "<folder>"]   (Markdown)
#   ./desk list
#   ./desk where [<absolute folder>]
here=$(cd "$(dirname "$0")" && pwd -P)
node=$(command -v node 2>/dev/null || cat "${CM_DATA_DIR:-$HOME/.tiny-hq}/node" 2>/dev/null || echo node)
exec "$node" --experimental-strip-types --disable-warning=ExperimentalWarning "$here/../src/cli/desk.ts" "$@"
